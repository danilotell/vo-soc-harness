# ---------------------------------------------------------------------------
# Custom Vision One MCP — configuración
#
# Copiar este archivo a `.env` (el setup ya lo hace) y completar las credenciales.
# Todas son OPCIONALES: el servidor siempre arranca, y las tools cuya credencial
# falte simplemente no se exponen.
# ---------------------------------------------------------------------------

# ===========================================================================
# LO MÍNIMO PARA EMPEZAR — con estas dos líneas ya se tiene triage y análisis.
# ===========================================================================

# URL base de la API de la región correspondiente (consultarla en la consola
# de Vision One):
VO_REGION=https://api.xdr.trendmicro.com

# API key de Vision One. Con permisos de LECTURA sobre Workbench y endpoints
# alcanza para todo el flujo salvo las acciones de respuesta.
VO_API_KEY=


# ===========================================================================
# OPCIONAL — integraciones extra
# ===========================================================================

# VirusTotal: habilita `get_ioc_reputation` (reputación de IOCs en Tier2).
VT_API_KEY=

# Slack: habilita `send_slack_summary` (notificaciones del Notifier).
SLACK_WEBHOOK_URL=


# ===========================================================================
# OPCIONAL — acciones de respuesta (contención)
# ===========================================================================
# Las tools destructivas (isolate_endpoint, add_to_block_list) NO se exponen
# hasta habilitarlas aquí a propósito. Requieren permisos de escritura en la
# API key.
# MCP_ENABLE_DESTRUCTIVE=false

# Quién le pide la aprobación al humano. Un cliente que SÍ soporta elicitation
# de MCP es preguntado siempre por el servidor; esta variable solo decide qué
# pasa cuando el cliente NO puede ser preguntado:
#   true (default) -> la acción se RECHAZA (fail closed).
#   false          -> se acepta el gate del cliente; cada llamada queda
#                     auditada como `approval_delegated`.
#
# OpenCode no implementa elicitation (verificado en agosto de 2026 contra
# OpenCode 1.18): para operar con él se necesita `false` y su propio gate
# (.opencode/plugins/harness-guard.js lo fuerza).
# MCP_REQUIRE_APPROVAL=true


# ===========================================================================
# OPCIONAL — transporte
# ===========================================================================
# stdio (default) es local: el cliente levanta el proceso. http sirve para
# exponerlo en red.
# MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8000

# Token bearer EXIGIDO en transporte http. Si no se define, el servidor queda
# abierto a quien alcance el puerto (loguea una advertencia). No aplica a stdio.
# MCP_AUTH_TOKEN=cambia-esto-por-un-secreto-largo


# ===========================================================================
# OPCIONAL — qué tools se exponen
# ===========================================================================
# Un nombre o tag inexistente es un ERROR DE ARRANQUE, no una regla que no
# filtra nada. Tags válidos: alerts, endpoints, response, intel, notify, meta,
# read, write, destructive.
# MCP_ENABLED_TOOLS=get_alert_list,get_alert_details   # allowlist (solo estas)
# MCP_DISABLED_TOOLS=send_slack_summary                # denylist por nombre
# MCP_DISABLED_TAGS=write                              # denylist por categoría


# ===========================================================================
# OPCIONAL — observabilidad y ajuste fino
# ===========================================================================
# MCP_LOG_LEVEL=INFO

# Traza de auditoría (JSON lines, rotada) en su propio archivo. Recomendado en
# producción: si no se define, va a stderr junto con el resto de los logs.
# Basta con descomentar la línea. Una ruta relativa se resuelve contra la raíz
# del clon (no contra el directorio desde el que se lanza el servidor), y el
# directorio se crea solo si falta. También se acepta una ruta absoluta, por
# ejemplo /var/log/vo-mcp/audit.log.
# MCP_AUDIT_LOG_FILE=audit/vo-audit.log

# Identidad de quien opera ESTE clon. Se estampa en cada registro de auditoría
# junto con el host y el usuario del sistema operativo, firma cada nota que se
# escribe en Vision One, y aparece en el reporte de cada alerta gestionada — así
# una revisión posterior puede decir quién siguió el flujo y quién autorizó una
# contención.
# OBLIGATORIO si MCP_ENABLE_DESTRUCTIVE=true: el servidor no arranca sin esto.
#
# El harness asume UN CLON POR ANALISTA, cada uno con su propio .env. Es la
# precondición de que esa identidad signifique algo: si dos personas comparten un
# clon, las dos actúan con este mismo id y la traza nombra al dueño del clon, no a
# quien actuó. No se puede hacer cumplir por código; es una regla de despliegue.
# MCP_OPERATOR_ID=nombre.apellido

# Oculta los detalles internos de error al cliente (solo quedan en los logs).
# MCP_MASK_ERROR_DETAILS=true
# MCP_ENABLE_HTTP2=true
# VT_BASE_URL=https://www.virustotal.com/api/v3

# Cliente HTTP: CONNECT_TIMEOUT, REQUEST_TIMEOUT, MAX_CONNECTIONS,
# MAX_KEEPALIVE_CONNECTIONS, MAX_RETRIES, BACKOFF_BASE, BACKOFF_MAX, MAX_PAGES.
